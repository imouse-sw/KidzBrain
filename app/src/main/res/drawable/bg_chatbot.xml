<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- fondo principal -->

    <item>
        <shape android:shape="rectangle">
            <solid android:color="#F5F7FA"/>
        </shape>
    </item>

    <!-- circulo rosa -->

    <item
        android:top="-120dp"
        android:right="-120dp">

        <shape android:shape="oval">
            <size
                android:width="240dp"
                android:height="240dp"/>

            <solid android:color="#FFD6E0"/>
        </shape>
    </item>

    <!-- circulo amarillo -->

    <item
        android:left="-80dp"
        android:bottom="-80dp">

        <shape android:shape="oval">
            <size
                android:width="180dp"
                android:height="180dp"/>

            <solid android:color="#FFF1B8"/>
        </shape>
    </item>

</layer-list>