<?xml version="1.0" encoding="utf-8"?>
<selector xmlns:android="http://schemas.android.com/apk/res/android">

    <item android:state_pressed="true">
        <shape>
            <corners android:radius="20dp" />
            <solid android:color="#D6EEFF" />
            <stroke
                android:width="2dp"
                android:color="#7CC6FE" />
        </shape>
    </item>

    <item>
        <shape>
            <corners android:radius="20dp" />
            <solid android:color="#F1FAFF" />
            <stroke
                android:width="2dp"
                android:color="#BDE0FE" />
        </shape>
    </item>

</selector>