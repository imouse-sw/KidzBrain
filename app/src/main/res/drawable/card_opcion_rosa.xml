<?xml version="1.0" encoding="utf-8"?>
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_pressed="true">
        <shape>
            <corners android:radius="24dp"/>
            <gradient
                android:startColor="#FFC6DE"
                android:endColor="#F4A7C1"
                android:angle="0"/>
            <stroke
                android:width="2dp"
                android:color="#E78FB3"/>
        </shape>
    </item>

    <item>
        <shape>
            <corners android:radius="24dp"/>
            <gradient
                android:startColor="#FFF1F7"
                android:endColor="#FFD6E7"
                android:angle="0"/>
            <stroke
                android:width="2dp"
                android:color="#F4C2D7"/>
        </shape>
    </item>
</selector>