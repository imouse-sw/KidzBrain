<?xml version="1.0" encoding="utf-8"?>
<selector xmlns:android="http://schemas.android.com/apk/res/android">

    <item android:state_pressed="true">
        <shape>
            <corners android:radius="20dp" />
            <solid android:color="#DDF8E8" />
            <stroke
                android:width="2dp"
                android:color="#8FD3A8" />
        </shape>
    </item>

    <item>
        <shape>
            <corners android:radius="20dp" />
            <solid android:color="#F3FFF7" />
            <stroke
                android:width="2dp"
                android:color="#B7E4C7" />
        </shape>
    </item>

</selector>