<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/background_recovery"
    android:fitsSystemWindows="true"
    tools:context=".RecuperarPasswordActivity">

    <View
        android:layout_width="200dp"
        android:layout_height="200dp"
        android:background="@drawable/deco_circle_pastel_pink"
        android:alpha="0.6"
        android:layout_marginTop="-50dp"
        android:layout_marginStart="-50dp"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent" />

    <View
        android:layout_width="150dp"
        android:layout_height="150dp"
        android:background="@drawable/deco_circle_green"
        android:alpha="0.8"
        android:layout_marginBottom="100dp"
        android:layout_marginEnd="-40dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <ImageView
        android:id="@+id/ivBrainbotFeliz"
        android:layout_width="120dp"
        android:layout_height="120dp"
        android:src="@drawable/cliente_3"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        android:layout_marginTop="60dp"
        android:contentDescription="Brainbot" />

    <LinearLayout
        android:id="@+id/recovery_card"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:background="@drawable/card_background"
        android:padding="32dp"
        android:elevation="16dp"
        android:layout_marginHorizontal="24dp"
        android:layout_marginTop="24dp"
        app:layout_constraintTop_toBottomOf="@+id/ivBrainbotFeliz">

        <LinearLayout
            android:id="@+id/layoutPaso1"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Recuperar Cuenta"
                android:fontFamily="@font/syne"
                android:textSize="24sp"
                android:textColor="#2D3E50"
                android:textStyle="bold"
                android:gravity="center"
                android:layout_marginBottom="12dp"/>

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Ingresa tu correo para recibir un código de seguridad."
                android:fontFamily="@font/syne"
                android:textSize="14sp"
                android:textColor="#455A64"
                android:gravity="center"
                android:layout_marginBottom="24dp"/>

            <EditText
                android:id="@+id/etCorreoRecuperacion"
                android:layout_width="match_parent"
                android:layout_height="56dp"
                android:background="@drawable/input_background"
                android:hint="Correo electrónico"
                android:paddingHorizontal="20dp"
                android:fontFamily="@font/syne"
                android:textColor="#333"
                android:textColorHint="#90A4AE"
                android:inputType="textEmailAddress"
                android:layout_marginBottom="20dp"/>

            <androidx.appcompat.widget.AppCompatButton
                android:id="@+id/btnEnviarCodigo"
                android:layout_width="match_parent"
                android:layout_height="60dp"
                android:text="ENVIAR CÓDIGO"
                android:fontFamily="@font/syne"
                android:textSize="16sp"
                android:textStyle="bold"
                android:textColor="#FFFFFF"
                android:background="@drawable/button_background"
                android:stateListAnimator="@null"/>

            <TextView
                android:id="@+id/tvVolverLogin1"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Cancelar y volver"
                android:fontFamily="@font/syne"
                android:textColor="#D372A3"
                android:textStyle="bold"
                android:layout_gravity="center"
                android:padding="12dp"
                android:layout_marginTop="12dp"/>
        </LinearLayout>

        <LinearLayout
            android:id="@+id/layoutPaso2"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:visibility="gone">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Nueva Contraseña"
                android:fontFamily="@font/syne"
                android:textSize="24sp"
                android:textColor="#2D3E50"
                android:textStyle="bold"
                android:gravity="center"
                android:layout_marginBottom="12dp"/>

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Escribe el código de 6 dígitos enviado a tu correo y tu nueva clave."
                android:fontFamily="@font/syne"
                android:textSize="14sp"
                android:textColor="#455A64"
                android:gravity="center"
                android:layout_marginBottom="24dp"/>

            <EditText
                android:id="@+id/etCodigo"
                android:layout_width="match_parent"
                android:layout_height="56dp"
                android:background="@drawable/input_background"
                android:hint="Código (ej. 123456)"
                android:paddingHorizontal="20dp"
                android:fontFamily="@font/syne"
                android:textColor="#333"
                android:textColorHint="#90A4AE"
                android:inputType="number"
                android:maxLength="6"
                android:layout_marginBottom="12dp"/>

            <EditText
                android:id="@+id/etNuevaPassword"
                android:layout_width="match_parent"
                android:layout_height="56dp"
                android:background="@drawable/input_background"
                android:hint="Nueva contraseña"
                android:paddingHorizontal="20dp"
                android:fontFamily="@font/syne"
                android:textColor="#333"
                android:textColorHint="#90A4AE"
                android:inputType="textPassword"
                android:layout_marginBottom="12dp"/>

            <EditText
                android:id="@+id/etConfirmarPassword"
                android:layout_width="match_parent"
                android:layout_height="56dp"
                android:background="@drawable/input_background"
                android:hint="Confirmar contraseña"
                android:paddingHorizontal="20dp"
                android:fontFamily="@font/syne"
                android:textColor="#333"
                android:textColorHint="#90A4AE"
                android:inputType="textPassword"
                android:layout_marginBottom="20dp"/>

            <androidx.appcompat.widget.AppCompatButton
                android:id="@+id/btnRestablecerPassword"
                android:layout_width="match_parent"
                android:layout_height="60dp"
                android:text="CAMBIAR CLAVE"
                android:fontFamily="@font/syne"
                android:textSize="16sp"
                android:textStyle="bold"
                android:textColor="#FFFFFF"
                android:background="@drawable/button_background"
                android:stateListAnimator="@null"/>

            <TextView
                android:id="@+id/tvVolverLogin2"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Cancelar"
                android:fontFamily="@font/syne"
                android:textColor="#D372A3"
                android:textStyle="bold"
                android:layout_gravity="center"
                android:padding="12dp"
                android:layout_marginTop="8dp"/>
        </LinearLayout>

    </LinearLayout>
</androidx.constraintlayout.widget.ConstraintLayout>