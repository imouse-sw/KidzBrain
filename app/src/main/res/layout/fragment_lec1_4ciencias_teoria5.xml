<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <ImageView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:alpha="0.7"
        android:scaleType="centerCrop"
        android:src="@drawable/fondo_ciencias3" />

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:fillViewport="true">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:layout_margin="20dp"
            android:background="#94000000"
            android:orientation="vertical"
            android:padding="20dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="El Hábitat del Conejo"
                android:textColor="#FF8C00"
                android:textSize="24sp"
                android:layout_gravity="center"/>

            <ImageView
                android:layout_width="243dp"
                android:layout_height="400dp"
                android:layout_gravity="center"
                android:layout_marginTop="10dp"
                android:src="@drawable/conejo_madriguera" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="20dp"
                android:text="El conejo vive en madrigueras bajo tierra para esconderse y estar protegido."
                android:textColor="#DDDDDD"
                android:textSize="20sp"
                android:textStyle="italic"
                android:gravity="center" />
        </LinearLayout>
    </ScrollView>
</FrameLayout>