<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true"
    android:background="#E1F5FE"> <LinearLayout
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:gravity="center_horizontal"
    android:padding="20dp">

    <TextView
        android:id="@+id/txt_titulo_ejer"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="¡Cuenta los cuadritos!"
        android:textColor="#0277BD"
        android:textSize="24sp"
        android:textStyle="bold"
        android:layout_marginBottom="10dp"/>

    <TextView
        android:id="@+id/txt_progreso_porc"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Pregunta 1 de 4"
        android:textColor="#01579B"
        android:textSize="16sp"
        android:layout_marginBottom="20dp"/>

    <ImageView
        android:id="@+id/img_ejercicio_porc"
        android:layout_width="250dp"
        android:layout_height="250dp"
        android:background="#FFFFFF"
        android:padding="10dp"
        android:layout_marginBottom="30dp"
        android:scaleType="fitCenter"/>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center"
        android:orientation="horizontal">

        <Button
            android:id="@+id/btn_p_op0"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="10%"
            android:layout_margin="5dp"
            android:backgroundTint="#03A9F4"/>

        <Button
            android:id="@+id/btn_p_op1"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="50%"
            android:layout_margin="5dp"
            android:backgroundTint="#03A9F4"/>

        <Button
            android:id="@+id/btn_p_op2"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="100%"
            android:layout_margin="5dp"
            android:backgroundTint="#03A9F4"/>
    </LinearLayout>
</LinearLayout>
</ScrollView>