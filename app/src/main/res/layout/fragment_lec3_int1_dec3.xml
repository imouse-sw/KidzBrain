<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_gravity="center"
    android:layout_height="match_parent">

    <ImageView
        android:id="@+id/img_act1"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:src="@drawable/decenas_act5"
        app:layout_constraintBottom_toTopOf="@id/img_act2"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintHorizontal_bias="0.0"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <ImageView
        android:id="@+id/img_act2"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:src="@drawable/decenas_act6"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/img_act1" />

    <EditText
        android:id="@+id/edit_centenas"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:hint="Centenas"
        android:inputType="number"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintVertical_bias="0.89"
        app:layout_constraintHorizontal_bias="0.14" />

    <EditText
        android:id="@+id/edit_decenas"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:hint="Decenas"
        android:inputType="number"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintVertical_bias="0.39"
        app:layout_constraintHorizontal_bias="0.24" />

    <EditText
        android:id="@+id/edit_decenas2"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:hint="Decenas"
        android:inputType="number"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintVertical_bias="0.89"
        app:layout_constraintHorizontal_bias="0.51" />

    <EditText
        android:id="@+id/edit_unidades"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:hint="Unidades"
        android:inputType="number"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintVertical_bias="0.39"
        app:layout_constraintHorizontal_bias="0.78" />

    <EditText
        android:id="@+id/edit_unidades2"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:hint="Unidades"
        android:inputType="number"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintVertical_bias="0.89"
        app:layout_constraintHorizontal_bias="0.88" />

    <Button
        android:id="@+id/btn_comprobar"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Comprobar"
        tools:layout_editor_absoluteX="145dp"
        tools:layout_editor_absoluteY="356dp"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintVertical_bias="0.52"/>


</androidx.constraintlayout.widget.ConstraintLayout>