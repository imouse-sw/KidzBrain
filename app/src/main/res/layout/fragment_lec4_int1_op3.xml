<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#EFEBE9">

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toBottomOf="parent"
        android:paddingHorizontal="24dp"
        android:clipToPadding="false">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingTop="80dp"
            android:paddingBottom="40dp"
            android:gravity="center_horizontal">

            <androidx.cardview.widget.CardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                app:cardCornerRadius="20dp"
                app:cardElevation="8dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="24dp"
                    android:gravity="center_horizontal"
                    android:background="@drawable/card_math_intermediate_background">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Selecciona 6/8"
                        android:fontFamily="@font/syne"
                        android:textSize="22sp"
                        android:textStyle="bold"
                        android:textColor="#2D3E50"
                        android:layout_marginBottom="4dp"/>

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="(Imagina que es una barra de chocolate)"
                        android:fontFamily="@font/syne"
                        android:textColor="#2D3E50"
                        android:textSize="14sp"
                        android:layout_marginBottom="24dp"/>

                    <GridLayout
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:columnCount="2"
                        android:rowCount="4"
                        android:alignmentMode="alignMargins"
                        android:layout_marginBottom="24dp">

                        <ImageView android:id="@+id/slice1" android:src="@drawable/cuadro_chocolate" android:layout_width="60dp" android:layout_height="60dp" android:layout_margin="4dp" android:alpha="0.5" android:scaleType="fitCenter"/>
                        <ImageView android:id="@+id/slice2" android:src="@drawable/cuadro_chocolate" android:layout_width="60dp" android:layout_height="60dp" android:layout_margin="4dp" android:alpha="0.5" android:scaleType="fitCenter"/>
                        <ImageView android:id="@+id/slice3" android:src="@drawable/cuadro_chocolate" android:layout_width="60dp" android:layout_height="60dp" android:layout_margin="4dp" android:alpha="0.5" android:scaleType="fitCenter"/>
                        <ImageView android:id="@+id/slice4" android:src="@drawable/cuadro_chocolate" android:layout_width="60dp" android:layout_height="60dp" android:layout_margin="4dp" android:alpha="0.5" android:scaleType="fitCenter"/>
                        <ImageView android:id="@+id/slice5" android:src="@drawable/cuadro_chocolate" android:layout_width="60dp" android:layout_height="60dp" android:layout_margin="4dp" android:alpha="0.5" android:scaleType="fitCenter"/>
                        <ImageView android:id="@+id/slice6" android:src="@drawable/cuadro_chocolate" android:layout_width="60dp" android:layout_height="60dp" android:layout_margin="4dp" android:alpha="0.5" android:scaleType="fitCenter"/>
                        <ImageView android:id="@+id/slice7" android:src="@drawable/cuadro_chocolate" android:layout_width="60dp" android:layout_height="60dp" android:layout_margin="4dp" android:alpha="0.5" android:scaleType="fitCenter"/>
                        <ImageView android:id="@+id/slice8" android:src="@drawable/cuadro_chocolate" android:layout_width="60dp" android:layout_height="60dp" android:layout_margin="4dp" android:alpha="0.5" android:scaleType="fitCenter"/>

                    </GridLayout>

                    <Button
                        android:id="@+id/btn_comprobar_pizza"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Comprobar"
                        android:fontFamily="@font/syne"
                        android:backgroundTint="#4a3229"
                        android:textColor="#FFFFFF"/>

                </LinearLayout>
            </androidx.cardview.widget.CardView>

        </LinearLayout>
    </ScrollView>

</androidx.constraintlayout.widget.ConstraintLayout>