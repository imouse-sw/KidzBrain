<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:gravity="center"
    android:background="#EFEBE9"> <TextView
    android:layout_width="wrap_content"
    android:layout_height="wrap_content"
    android:text="Selecciona 6/8"
    android:textSize="26sp"
    android:textStyle="bold"
    android:textColor="#5D4037"
    android:layout_marginBottom="10dp"/>

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="(Imagina que es una barra de chocolate)"
        android:textSize="14sp"
        android:textColor="#8D6E63"
        android:layout_marginBottom="30dp"/>

    <GridLayout
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:columnCount="4"
        android:rowCount="2"
        android:alignmentMode="alignMargins">

        <ImageView
            android:id="@+id/slice1"
            android:src="@drawable/cuadro_chocolate"
            android:layout_width="70dp"
            android:layout_height="70dp"
            android:layout_margin="4dp"
            android:alpha="0.5"
            android:scaleType="fitCenter"/>
        <ImageView android:id="@+id/slice2" android:src="@drawable/cuadro_chocolate" android:layout_width="70dp" android:layout_height="70dp" android:layout_margin="4dp" android:alpha="0.5" android:scaleType="fitCenter"/>

        <ImageView android:id="@+id/slice3" android:src="@drawable/cuadro_chocolate" android:layout_width="70dp" android:layout_height="70dp" android:layout_margin="4dp" android:alpha="0.5" android:scaleType="fitCenter"/>

        <ImageView android:id="@+id/slice4" android:src="@drawable/cuadro_chocolate" android:layout_width="70dp" android:layout_height="70dp" android:layout_margin="4dp" android:alpha="0.5" android:scaleType="fitCenter"/>

        <ImageView android:id="@+id/slice5" android:src="@drawable/cuadro_chocolate" android:layout_width="70dp" android:layout_height="70dp" android:layout_margin="4dp" android:alpha="0.5" android:scaleType="fitCenter"/>

        <ImageView android:id="@+id/slice6" android:src="@drawable/cuadro_chocolate" android:layout_width="70dp" android:layout_height="70dp" android:layout_margin="4dp" android:alpha="0.5" android:scaleType="fitCenter"/>

        <ImageView android:id="@+id/slice7" android:src="@drawable/cuadro_chocolate" android:layout_width="70dp" android:layout_height="70dp" android:layout_margin="4dp" android:alpha="0.5" android:scaleType="fitCenter"/>

        <ImageView android:id="@+id/slice8" android:src="@drawable/cuadro_chocolate" android:layout_width="70dp" android:layout_height="70dp" android:layout_margin="4dp" android:alpha="0.5" android:scaleType="fitCenter"/>

    </GridLayout>

    <Button
        android:id="@+id/btn_comprobar_pizza"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Comprobar"
        android:textSize="18sp"
        android:layout_marginTop="40dp"
        android:backgroundTint="#795548"/> </LinearLayout>