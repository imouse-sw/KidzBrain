<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/rootLayout"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#E1F5FE"
    tools:context=".mapa_niveles">

    <View
        android:layout_width="300dp"
        android:layout_height="300dp"
        android:background="@drawable/deco_circle_pink"
        android:alpha="0.4"
        android:layout_marginTop="-100dp"
        android:layout_marginStart="-100dp"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent" />

    <View
        android:layout_width="200dp"
        android:layout_height="200dp"
        android:background="@drawable/deco_circle_yellow"
        android:alpha="0.5"
        android:layout_marginBottom="-50dp"
        android:layout_marginEnd="-50dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/headerContainer"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:padding="24dp"
        android:elevation="10dp"
        app:layout_constraintTop_toTopOf="parent">

        <ImageView
            android:id="@+id/btnBack"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:src="@drawable/abc_ic_ab_back_material"
            android:background="@drawable/card_menu_icon"
            android:padding="8dp"
            android:elevation="4dp"
            app:tint="#546E7A"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintBottom_toBottomOf="parent"/>
        <TextView
            android:id="@+id/tvTituloMateria"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Aventura"
            android:fontFamily="@font/syne"
            android:textSize="28sp"
            android:textStyle="bold"
            android:textColor="#37474F"
            app:layout_constraintStart_toEndOf="@id/btnBack"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintBottom_toBottomOf="parent"/>

    </androidx.constraintlayout.widget.ConstraintLayout>

    <ScrollView
        android:id="@+id/scrollNiveles"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:clipToPadding="false"
        android:paddingTop="20dp"
        android:paddingBottom="40dp"
        app:layout_constraintTop_toBottomOf="@id/headerContainer"
        app:layout_constraintBottom_toBottomOf="parent">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:gravity="center_horizontal"
            android:paddingBottom="100dp">

            <!-- Nivel 1 -->
            <RelativeLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:paddingHorizontal="50dp">
                <androidx.appcompat.widget.AppCompatButton
                    android:id="@+id/btnNivel1"
                    android:layout_width="90dp"
                    android:layout_height="90dp"
                    android:layout_alignParentEnd="true"
                    android:text="1"
                    android:textSize="32sp"
                    android:fontFamily="@font/syne"
                    android:textStyle="bold"
                    android:textColor="#FFFFFF"
                    android:background="@drawable/bg_nivel_activo"
                    android:stateListAnimator="@null"/>
            </RelativeLayout>

            <View
                android:layout_width="6dp"
                android:layout_height="60dp"
                android:background="@drawable/camino_punteado"
                android:layout_marginVertical="5dp"
                android:rotation="25"/>

            <!-- Nivel 2 -->
            <RelativeLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:paddingHorizontal="50dp">
                <androidx.appcompat.widget.AppCompatButton
                    android:id="@+id/btnNivel2"
                    android:layout_width="90dp"
                    android:layout_height="90dp"
                    android:layout_alignParentStart="true"
                    android:text="2"
                    android:textSize="32sp"
                    android:fontFamily="@font/syne"
                    android:textStyle="bold"
                    android:textColor="#FFFFFF"
                    android:background="@drawable/bg_nivel_bloqueado"
                    android:stateListAnimator="@null"/>
            </RelativeLayout>

            <View
                android:layout_width="6dp"
                android:layout_height="60dp"
                android:background="@drawable/camino_punteado"
                android:layout_marginVertical="5dp"
                android:rotation="-25"/>

            <!-- Nivel 3 -->
            <RelativeLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:paddingHorizontal="50dp">
                <androidx.appcompat.widget.AppCompatButton
                    android:id="@+id/btnNivel3"
                    android:layout_width="90dp"
                    android:layout_height="90dp"
                    android:layout_alignParentEnd="true"
                    android:text="3"
                    android:textSize="32sp"
                    android:fontFamily="@font/syne"
                    android:textStyle="bold"
                    android:textColor="#FFFFFF"
                    android:background="@drawable/bg_nivel_bloqueado"
                    android:stateListAnimator="@null"/>
            </RelativeLayout>

            <View
                android:layout_width="6dp"
                android:layout_height="60dp"
                android:background="@drawable/camino_punteado"
                android:layout_marginVertical="5dp"
                android:rotation="25"/>

            <!-- Nivel 4 -->
            <RelativeLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:paddingHorizontal="50dp">
                <androidx.appcompat.widget.AppCompatButton
                    android:id="@+id/btnNivel4"
                    android:layout_width="90dp"
                    android:layout_height="90dp"
                    android:layout_alignParentStart="true"
                    android:text="4"
                    android:textSize="32sp"
                    android:fontFamily="@font/syne"
                    android:textStyle="bold"
                    android:textColor="#FFFFFF"
                    android:background="@drawable/bg_nivel_bloqueado"
                    android:stateListAnimator="@null"/>
            </RelativeLayout>

            <View
                android:layout_width="6dp"
                android:layout_height="60dp"
                android:background="@drawable/camino_punteado"
                android:layout_marginVertical="5dp"
                android:rotation="-25"/>

            <!-- Nivel 5 -->
            <RelativeLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:paddingHorizontal="50dp">
                <androidx.appcompat.widget.AppCompatButton
                    android:id="@+id/btnNivel5"
                    android:layout_width="90dp"
                    android:layout_height="90dp"
                    android:layout_alignParentEnd="true"
                    android:text="5"
                    android:textSize="32sp"
                    android:fontFamily="@font/syne"
                    android:textStyle="bold"
                    android:textColor="#FFFFFF"
                    android:background="@drawable/bg_nivel_bloqueado"
                    android:stateListAnimator="@null"/>
            </RelativeLayout>

            <View
                android:layout_width="6dp"
                android:layout_height="60dp"
                android:background="@drawable/camino_punteado"
                android:layout_marginVertical="5dp"
                android:rotation="25"/>

            <!-- Nivel 6 -->
            <RelativeLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:paddingHorizontal="50dp">
                <androidx.appcompat.widget.AppCompatButton
                    android:id="@+id/btnNivel6"
                    android:layout_width="90dp"
                    android:layout_height="90dp"
                    android:layout_alignParentStart="true"
                    android:text="6"
                    android:textSize="32sp"
                    android:fontFamily="@font/syne"
                    android:textStyle="bold"
                    android:textColor="#FFFFFF"
                    android:background="@drawable/bg_nivel_bloqueado"
                    android:stateListAnimator="@null"/>
            </RelativeLayout>

            <View
                android:layout_width="6dp"
                android:layout_height="60dp"
                android:background="@drawable/camino_punteado"
                android:layout_marginVertical="5dp"
                android:rotation="-25"/>

            <!-- Nivel 7 -->
            <RelativeLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:paddingHorizontal="50dp">
                <androidx.appcompat.widget.AppCompatButton
                    android:id="@+id/btnNivel7"
                    android:layout_width="90dp"
                    android:layout_height="90dp"
                    android:layout_alignParentEnd="true"
                    android:text="7"
                    android:textSize="32sp"
                    android:fontFamily="@font/syne"
                    android:textStyle="bold"
                    android:textColor="#FFFFFF"
                    android:background="@drawable/bg_nivel_bloqueado"
                    android:stateListAnimator="@null"/>
            </RelativeLayout>

            <View
                android:layout_width="6dp"
                android:layout_height="60dp"
                android:background="@drawable/camino_punteado"
                android:layout_marginVertical="5dp"
                android:rotation="25"/>

            <!-- Nivel 8 -->
            <RelativeLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:paddingHorizontal="50dp">
                <androidx.appcompat.widget.AppCompatButton
                    android:id="@+id/btnNivel8"
                    android:layout_width="90dp"
                    android:layout_height="90dp"
                    android:layout_alignParentStart="true"
                    android:text="8"
                    android:textSize="32sp"
                    android:fontFamily="@font/syne"
                    android:textStyle="bold"
                    android:textColor="#FFFFFF"
                    android:background="@drawable/bg_nivel_bloqueado"
                    android:stateListAnimator="@null"/>
            </RelativeLayout>

            <View
                android:layout_width="6dp"
                android:layout_height="60dp"
                android:background="@drawable/camino_punteado"
                android:layout_marginVertical="5dp"
                android:rotation="-25"/>

            <!-- Nivel 9 -->
            <RelativeLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:paddingHorizontal="50dp">
                <androidx.appcompat.widget.AppCompatButton
                    android:id="@+id/btnNivel9"
                    android:layout_width="90dp"
                    android:layout_height="90dp"
                    android:layout_alignParentEnd="true"
                    android:text="9"
                    android:textSize="32sp"
                    android:fontFamily="@font/syne"
                    android:textStyle="bold"
                    android:textColor="#FFFFFF"
                    android:background="@drawable/bg_nivel_bloqueado"
                    android:stateListAnimator="@null"/>
            </RelativeLayout>

        </LinearLayout>
    </ScrollView>

</androidx.constraintlayout.widget.ConstraintLayout>