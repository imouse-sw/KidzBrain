<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/layoutMapa"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    tools:context=".mapa_niveles">

    <!-- FONDO -->
    <ImageView
        android:id="@+id/fondoMapa"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:src="@drawable/fondo_mapa"
        android:scaleType="centerCrop"
        android:contentDescription="Fondo del mapa" />

    <!-- MARCO CENTRADO -->
    <FrameLayout
        android:id="@+id/marcoScroll"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_centerHorizontal="true"
        android:background="@drawable/marco_niveles"
        android:paddingTop="180dp"
        android:paddingBottom="20dp"
        android:paddingStart="60dp"
        android:paddingEnd="0dp">

        <!-- SCROLL CON MOVIMIENTO HACIA ARRIBA -->
        <ScrollView
            android:id="@+id/scrollNiveles"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:fillViewport="true">

            <LinearLayout
                android:id="@+id/contenedorNiveles"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:paddingTop="100dp"
                android:paddingBottom="100dp">

                <!-- NIVELES -->
                <!-- NIVEL 1 -->
                <RelativeLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content">

                    <Button
                        android:id="@+id/btnNivel1"
                        android:layout_width="120dp"
                        android:layout_height="120dp"
                        android:layout_alignParentEnd="true"
                        android:layout_marginEnd="60dp"
                        android:layout_marginBottom="40dp"
                        android:text="1"
                        android:textSize="22sp"
                        android:textStyle="bold"
                        android:textColor="#FFFFFFFF"
                        android:background="@drawable/boton_circular" />
                </RelativeLayout>

                <!-- NIVEL 2 -->
                <RelativeLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content">

                    <Button
                        android:id="@+id/btnNivel2"
                        android:layout_width="120dp"
                        android:layout_height="120dp"
                        android:layout_alignParentStart="true"
                        android:layout_marginStart="30dp"
                        android:layout_marginBottom="40dp"
                        android:text="2"
                        android:textSize="22sp"
                        android:textStyle="bold"
                        android:textColor="#FFFFFFFF"
                        android:background="@drawable/boton_circular" />
                </RelativeLayout>

                <!-- NIVEL 3 -->
                <RelativeLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content">

                    <Button
                        android:id="@+id/btnNivel3"
                        android:layout_width="120dp"
                        android:layout_height="120dp"
                        android:layout_alignParentEnd="true"
                        android:layout_marginEnd="30dp"
                        android:layout_marginBottom="60dp"
                        android:text="3"
                        android:textSize="22sp"
                        android:textStyle="bold"
                        android:textColor="#FFFFFFFF"
                        android:background="@drawable/boton_circular" />
                </RelativeLayout>

                <!-- NIVEL 4 -->
                <RelativeLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content">

                    <Button
                        android:id="@+id/btnNivel4"
                        android:layout_width="120dp"
                        android:layout_height="120dp"
                        android:layout_alignParentStart="true"
                        android:layout_marginStart="30dp"
                        android:layout_marginBottom="40dp"
                        android:text="4"
                        android:textSize="22sp"
                        android:textStyle="bold"
                        android:textColor="#FFFFFFFF"
                        android:background="@drawable/boton_circular" />
                </RelativeLayout>

                <!-- NIVEL 5 -->
                <RelativeLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content">

                    <Button
                        android:id="@+id/btnNivel5"
                        android:layout_width="120dp"
                        android:layout_height="120dp"
                        android:layout_alignParentEnd="true"
                        android:layout_marginEnd="30dp"
                        android:layout_marginBottom="40dp"
                        android:text="5"
                        android:textSize="22sp"
                        android:textStyle="bold"
                        android:textColor="#FFFFFFFF"
                        android:background="@drawable/boton_circular" />
                </RelativeLayout>

                <!-- NIVEL 6 -->
                <RelativeLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content">

                    <Button
                        android:id="@+id/btnNivel6"
                        android:layout_width="120dp"
                        android:layout_height="120dp"
                        android:layout_alignParentStart="true"
                        android:layout_marginStart="30dp"
                        android:layout_marginBottom="40dp"
                        android:text="6"
                        android:textSize="22sp"
                        android:textStyle="bold"
                        android:textColor="#FFFFFFFF"
                        android:background="@drawable/boton_circular" />
                </RelativeLayout>

                <!-- NIVEL 7 -->
                <RelativeLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content">

                    <Button
                        android:id="@+id/btnNivel7"
                        android:layout_width="120dp"
                        android:layout_height="120dp"
                        android:layout_alignParentEnd="true"
                        android:layout_marginEnd="30dp"
                        android:layout_marginBottom="40dp"
                        android:text="7"
                        android:textSize="22sp"
                        android:textStyle="bold"
                        android:textColor="#FFFFFFFF"
                        android:background="@drawable/boton_circular" />
                </RelativeLayout>

                <!-- NIVEL 8 -->
                <RelativeLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content">

                    <Button
                        android:id="@+id/btnNivel8"
                        android:layout_width="120dp"
                        android:layout_height="120dp"
                        android:layout_alignParentStart="true"
                        android:layout_marginStart="30dp"
                        android:layout_marginBottom="40dp"
                        android:text="8"
                        android:textSize="22sp"
                        android:textStyle="bold"
                        android:textColor="#FFFFFFFF"
                        android:background="@drawable/boton_circular" />
                </RelativeLayout>

            </LinearLayout>
        </ScrollView>

    </FrameLayout>

</RelativeLayout>

