<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/background_main"
    tools:context=".MainActivity">

    <!-- === DECORACIÓN DE FONDO (Círculos Flotantes) === -->
    <View
        android:layout_width="200dp"
        android:layout_height="200dp"
        android:background="@drawable/deco_circle_pink"
        android:alpha="0.6"
        android:layout_marginTop="-50dp"
        android:layout_marginStart="-50dp"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent" />

    <View
        android:layout_width="150dp"
        android:layout_height="150dp"
        android:background="@drawable/deco_circle_yellow"
        android:alpha="0.8"
        android:layout_marginBottom="100dp"
        android:layout_marginEnd="-40dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <!-- === IMAGEN DEL PANITA FELIZ === -->
    <ImageView
        android:id="@+id/ivBrainbotFeliz"
        android:layout_width="150dp"
        android:layout_height="150dp"
        android:src="@drawable/bb_feliz"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        android:layout_marginTop="40dp"
        android:contentDescription="Bebé feliz saludando" />

    <!-- === TÍTULO APP === -->
    <ImageView
        android:id="@+id/ivTitle"
        android:layout_width="350dp"
        android:layout_height="wrap_content"
        android:src="@drawable/kidzbrain_title"
        android:adjustViewBounds="true"
        app:layout_constraintTop_toBottomOf="@id/ivBrainbotFeliz"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        android:layout_marginTop="-75dp"
        android:contentDescription="Título KidzBrain" />

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Tu mundo de juegos"
        android:fontFamily="@font/syne"
        android:textColor="#FFFFFF"
        android:textSize="20sp"
        android:textStyle="bold"
        app:layout_constraintTop_toBottomOf="@id/ivTitle"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <!-- === TARJETA DE LOGIN === -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:background="@drawable/card_background"
        android:padding="32dp"
        android:elevation="16dp"
        android:layout_marginHorizontal="24dp"
        app:layout_constraintTop_toBottomOf="@id/ivTitle"
        app:layout_constraintBottom_toBottomOf="parent">

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="¡A Jugar!"
            android:fontFamily="@font/syne"
            android:textSize="26sp"
            android:textColor="#2D3E50"
            android:textStyle="bold"
            android:gravity="center"
            android:layout_marginBottom="24dp"/>

        <!-- CAMPO USUARIO -->
        <EditText
            android:id="@+id/etUser"
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:background="@drawable/input_background"
            android:hint="Nombre de Usuario"
            android:paddingHorizontal="20dp"
            android:fontFamily="@font/syne"
            android:textColor="#333"
            android:textColorHint="#90A4AE"
            android:inputType="textPersonName"
            android:layout_marginBottom="16dp"/>

        <!-- CAMPO PASSWORD -->
        <EditText
            android:id="@+id/etPass"
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:background="@drawable/input_background"
            android:hint="Contraseña"
            android:paddingHorizontal="20dp"
            android:fontFamily="@font/syne"
            android:textColor="#333"
            android:textColorHint="#90A4AE"
            android:inputType="textPassword"
            android:layout_marginBottom="24dp"/>

        <!-- BOTÓN ENTRAR -->
        <androidx.appcompat.widget.AppCompatButton
            android:id="@+id/btnLogin"
            android:layout_width="match_parent"
            android:layout_height="60dp"
            android:text="ENTRAR"
            android:fontFamily="@font/syne"
            android:textSize="18sp"
            android:textStyle="bold"
            android:textColor="#FFFFFF"
            android:background="@drawable/button_background"
            android:stateListAnimator="@null"/>

        <!-- TEXTO REGISTRO -->
        <TextView
            android:id="@+id/tvRegister"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="¿Nuevo aquí? Crea una cuenta"
            android:fontFamily="@font/syne"
            android:textColor="#D372A3"
            android:textStyle="bold"
            android:layout_gravity="center"
            android:padding="12dp"
            android:layout_marginTop="12dp"/>

    </LinearLayout>

</androidx.constraintlayout.widget.ConstraintLayout>