<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:gravity="center_horizontal"
    android:padding="20dp"
    android:background="#F3E5F5"> <!-- Fondo lila muy suave -->

    <!-- Encabezado y Progreso -->
    <TextView
        android:id="@+id/txt_titulo_juego"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Identifica el Ángulo"
        android:textColor="#7B1FA2"
        android:textSize="24sp"
        android:textStyle="bold"
        android:layout_marginBottom="10dp"/>

    <TextView
        android:id="@+id/txt_progreso_angulos"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Figura 1 de 5"
        android:textSize="16sp"
        android:textColor="#4A148C"
        android:layout_marginBottom="20dp"/>

    <!-- Tarjeta para la Imagen -->
    <androidx.cardview.widget.CardView
        android:layout_width="280dp"
        android:layout_height="220dp"
        android:layout_marginBottom="30dp"
        android:elevation="8dp">

        <ImageView
            android:id="@+id/img_figura_angulo"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:scaleType="centerCrop"
            android:padding="10dp"
            android:src="@drawable/recto"
            android:contentDescription="Figura geométrica con ángulo resaltado" />
        <!-- Nota: Usa una imagen por defecto aquí -->
    </androidx.cardview.widget.CardView>

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="¿Qué tipo de ángulo es?"
        android:textSize="18sp"
        android:layout_marginBottom="20dp"/>

    <!-- Botones de Respuesta -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:gravity="center">

        <!-- Botón AGUDO -->
        <Button
            android:id="@+id/btn_agudo"
            android:layout_width="match_parent"
            android:layout_height="60dp"
            android:text="Agudo (Cerrado)"
            android:textSize="18sp"
            android:backgroundTint="#FF9800"
            android:layout_marginBottom="10dp"/>

        <!-- Botón RECTO -->
        <Button
            android:id="@+id/btn_recto"
            android:layout_width="match_parent"
            android:layout_height="60dp"
            android:text="Recto (L)"
            android:textSize="18sp"
            android:backgroundTint="#2196F3"
            android:layout_marginBottom="10dp"/>

        <!-- Botón OBTUSO -->
        <Button
            android:id="@+id/btn_obtuso"
            android:layout_width="match_parent"
            android:layout_height="60dp"
            android:text="Obtuso (Abierto)"
            android:textSize="18sp"
            android:backgroundTint="#9C27B0"/>

    </LinearLayout>

</LinearLayout>