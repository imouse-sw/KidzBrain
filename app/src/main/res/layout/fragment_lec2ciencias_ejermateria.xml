<?xml version="1.0" encoding="utf-8"?>
<FrameLayout
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    xmlns:android="http://schemas.android.com/apk/res/android">

    <ImageView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:alpha="0.8"
        android:src="@drawable/pizarron"
        android:scaleType="centerCrop"/>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:background="#99000000"
        android:gravity="center"
        android:padding="32dp">

        <TextView
            android:id="@+id/texto_pregunta_materia"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="¿Qué estado de la materia es este?"
            android:textColor="@color/white"
            android:textSize="28sp"
            android:textStyle="bold"
            android:textAlignment="center"
            android:layout_marginBottom="24dp"/>

        <ImageView
            android:id="@+id/imagen_ejercicio_materia"
            android:layout_width="wrap_content"
            android:layout_height="200dp"
            android:adjustViewBounds="true"
            android:src="@drawable/cubo"
            android:contentDescription="Imagen del estado de la materia"
            android:layout_marginBottom="32dp"/>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center">

            <Button
                android:id="@+id/boton_opcion_materia1"
                style="?android:attr/buttonStyleSmall"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginEnd="5dp"
                android:text="Sólido"
                android:textSize="15sp" />

            <Button
                android:id="@+id/boton_opcion_materia2"
                style="?android:attr/buttonStyleSmall"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Líquido"
                android:textSize="15sp"
                android:layout_marginEnd="5dp"/>

            <Button
                android:id="@+id/boton_opcion_materia3"
                style="?android:attr/buttonStyleSmall"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginEnd="5dp"
                android:text="Gaseoso"
                android:textSize="15sp" />

        </LinearLayout>

        <Button
            android:id="@+id/boton_siguiente_materia"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="32dp"
            android:text="Siguiente Pregunta"
            android:textSize="20sp"/>

    </LinearLayout>

</FrameLayout>
