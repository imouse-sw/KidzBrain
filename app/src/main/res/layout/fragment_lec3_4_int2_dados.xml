<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/background_math_advanced">

    <TextView
        android:id="@+id/titulo_ejercicio_dados"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="¡Lanza el Dado!"
        android:fontFamily="@font/syne"
        android:textSize="26sp"
        android:textStyle="bold"
        android:textColor="#FFFFFF"
        android:layout_marginTop="60dp"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <androidx.cardview.widget.CardView
        android:id="@+id/card_pregunta_dados"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginHorizontal="24dp"
        android:layout_marginTop="32dp"
        app:cardCornerRadius="25dp"
        app:layout_constraintTop_toBottomOf="@id/titulo_ejercicio_dados">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="30dp"
            android:gravity="center"
            android:background="@drawable/card_materia_math">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Si lanzas un dado de 6 caras,\n¿cuál es la probabilidad de que salga un 6?"
                android:textColor="#FFFFFF"
                android:fontFamily="@font/syne"
                android:textSize="18sp"
                android:gravity="center"
                android:layout_marginBottom="16dp"/>
            
            <ImageView
                android:layout_width="wrap_content"
                android:layout_height="300dp"
                android:src="@drawable/saki_dados"
                android:scaleType="fitCenter"/>
        </LinearLayout>
    </androidx.cardview.widget.CardView>

    <GridLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:columnCount="2"
        android:rowCount="1"
        android:padding="20dp"
        app:layout_constraintTop_toBottomOf="@id/card_pregunta_dados"
        app:layout_constraintBottom_toBottomOf="parent">

        <Button
            android:id="@+id/btn_opcion_1_6"
            android:layout_width="0dp"
            android:layout_height="80dp"
            android:layout_columnWeight="1"
            android:layout_margin="10dp"
            android:text="1/6"
            android:backgroundTint="#4CAF50"
            android:textColor="#FFFFFF"
            android:fontFamily="@font/syne"
            android:textSize="22sp"/>

        <Button
            android:id="@+id/btn_opcion_6_6"
            android:layout_width="0dp"
            android:layout_height="80dp"
            android:layout_columnWeight="1"
            android:layout_margin="10dp"
            android:text="6/6"
            android:backgroundTint="#F44336"
            android:textColor="#FFFFFF"
            android:fontFamily="@font/syne"
            android:textSize="22sp"/>
    </GridLayout>

</androidx.constraintlayout.widget.ConstraintLayout>