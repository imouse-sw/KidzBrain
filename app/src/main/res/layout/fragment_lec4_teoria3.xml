<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/background_math_intermediate">

    <View
        android:layout_width="180dp"
        android:layout_height="180dp"
        android:background="@drawable/deco_circle_green"
        android:alpha="0.6"
        android:layout_marginTop="-40dp"
        android:layout_marginEnd="-40dp"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <View
        android:layout_width="120dp"
        android:layout_height="120dp"
        android:background="@drawable/deco_circle_yellow"
        android:alpha="0.6"
        android:layout_marginBottom="50dp"
        android:layout_marginStart="-30dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent" />

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toBottomOf="parent"
        android:paddingHorizontal="24dp"
        android:clipToPadding="false">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingTop="40dp"
            android:paddingBottom="40dp"
            android:gravity="center_horizontal">

            <androidx.cardview.widget.CardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                app:cardCornerRadius="20dp"
                app:cardElevation="8dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="24dp"
                    android:gravity="center_horizontal"
                    android:background="@drawable/card_math_intermediate_background">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="La División"
                        android:fontFamily="@font/syne"
                        android:textSize="22sp"
                        android:textStyle="bold"
                        android:textColor="#2D3E50"
                        android:layout_marginBottom="4dp"/>

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Repartir de forma justa"
                        android:fontFamily="@font/syne"
                        android:textColor="#2D3E50"
                        android:textSize="16sp"
                        android:layout_marginBottom="24dp"/>

                    <ImageView
                        android:layout_width="200dp"
                        android:layout_height="160dp"
                        android:src="@drawable/galletas2"
                        android:scaleType="fitCenter"/>

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="12 en total"
                        android:fontFamily="@font/syne"
                        android:textColor="#2D3E50"
                        android:textSize="16sp"
                        android:textStyle="italic"
                        android:layout_marginBottom="8dp"/>

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="⬇️"
                        android:textSize="40sp"
                        android:layout_marginBottom="8dp"/>

                    <ImageView
                        android:layout_width="200dp"
                        android:layout_height="160dp"
                        android:src="@drawable/galletas3"
                        android:scaleType="fitCenter"/>

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="8dp"
                        android:gravity="center"
                        android:text="3 Amigos = 4 galletas cada uno"
                        android:fontFamily="@font/syne"
                        android:textColor="#3A7BD5"
                        android:textSize="18sp"
                        android:textStyle="bold" />

                </LinearLayout>
            </androidx.cardview.widget.CardView>

        </LinearLayout>
    </ScrollView>

</androidx.constraintlayout.widget.ConstraintLayout>