<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <ImageView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:alpha="0.7"
        android:scaleType="centerCrop"
        android:src="@drawable/fondo_salud" />

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:fillViewport="true">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:layout_margin="20dp"
            android:background="#94000000"
            android:orientation="vertical"
            android:padding="20dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Huesos y Músculos Fuertes"
                android:textColor="#FF5252"
                android:textSize="22sp"
                android:textStyle="bold"
                android:layout_gravity="center"/>

            <ImageView
                android:layout_width="279dp"
                android:layout_height="393dp"
                android:layout_gravity="center"
                android:layout_marginTop="15dp"
                android:src="@drawable/alimentos_crecer" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="15dp"
                android:text="El huevo, el pescado, la leche y los frijoles ayudan a que tu cuerpo crezca sano y se repare."
                android:textColor="#FFFFFF"
                android:textSize="16sp"
                android:gravity="center" />
        </LinearLayout>
    </ScrollView>
</FrameLayout>