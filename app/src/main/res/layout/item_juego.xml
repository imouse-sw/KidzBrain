<?xml version="1.0" encoding="utf-8"?>
<androidx.cardview.widget.CardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="180dp"
    app:cardCornerRadius="20dp"
    app:cardElevation="8dp"
    android:layout_margin="12dp">

    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent">

        <ImageView
            android:id="@+id/iv_juego_icono"
            android:layout_width="80dp"
            android:layout_height="80dp"
            android:src="@drawable/ic_games" 
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintBottom_toTopOf="@+id/tv_juego_nombre"
            app:layout_constraintVertical_chainStyle="packed"
            android:contentDescription="Icono del juego" />

        <TextView
            android:id="@+id/tv_juego_nombre"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Nombre del Juego"
            android:fontFamily="@font/syne"
            android:textColor="#2D3E50"
            android:textSize="24sp"
            android:textStyle="bold"
            android:layout_marginTop="12dp"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/iv_juego_icono"/>

        <TextView
            android:id="@+id/tv_juego_descripcion"
            android:layout_width="250dp"
            android:layout_height="wrap_content"
            android:text="Descripción del juego"
            android:fontFamily="@font/syne"
            android:textColor="#2D3E50"
            android:textSize="15sp"
            android:gravity="center"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/tv_juego_nombre"/>

    </androidx.constraintlayout.widget.ConstraintLayout>

</androidx.cardview.widget.CardView>