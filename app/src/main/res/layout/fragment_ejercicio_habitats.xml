<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="#E1F5FE"
    android:padding="16dp">

    <TextView
        android:id="@+id/texto_instruccion"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="¡Ayuda al animal a encontrar su casa!"
        android:textAlignment="center"
        android:textSize="22sp"
        android:textColor="#0277BD"
        android:textStyle="bold"
        android:layout_marginBottom="10dp"/>

    <TextView
        android:id="@+id/texto_explicacion"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Un hábitat tiene agua, comida y refugio."
        android:textAlignment="center"
        android:textSize="16sp"
        android:layout_marginBottom="20dp"/>

    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">

        <ImageView
            android:id="@+id/imagen_animal"
            android:layout_width="249dp"
            android:layout_height="282dp"
            android:layout_gravity="center"
            android:background="@drawable/redondeado_habitat"
            android:backgroundTint="#FFFFFF"
            android:elevation="4dp"
            android:padding="10dp" />
    </FrameLayout>

    <GridLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:columnCount="2"
        android:rowCount="2"
        android:alignmentMode="alignMargins">

        <LinearLayout
            android:id="@+id/habitat_agua"
            android:layout_width="0dp"
            android:layout_height="100dp"
            android:layout_columnWeight="1"
            android:layout_margin="8dp"
            android:background="@drawable/redondeado_habitat"
            android:backgroundTint="#29B6F6"
            android:gravity="center"
            android:orientation="vertical">
            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Mar" android:textColor="#FFF" android:textStyle="bold"/>
        </LinearLayout>

        <LinearLayout
            android:id="@+id/habitat_arbol"
            android:layout_width="0dp"
            android:layout_height="100dp"
            android:layout_columnWeight="1"
            android:layout_margin="8dp"
            android:background="@drawable/redondeado_habitat"
            android:backgroundTint="#66BB6A"
            android:gravity="center"
            android:orientation="vertical">
            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Bosque" android:textColor="#FFF" android:textStyle="bold"/>
        </LinearLayout>

        <LinearLayout
            android:id="@+id/habitat_tierra"
            android:layout_width="0dp"
            android:layout_height="100dp"
            android:layout_columnWeight="1"
            android:layout_margin="8dp"
            android:background="@drawable/redondeado_habitat"
            android:backgroundTint="#8D6E63"
            android:gravity="center"
            android:orientation="vertical">
            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Madriguera" android:textColor="#FFF" android:textStyle="bold"/>
        </LinearLayout>

        <LinearLayout
            android:id="@+id/habitat_selva"
            android:layout_width="0dp"
            android:layout_height="100dp"
            android:layout_columnWeight="1"
            android:layout_margin="8dp"
            android:background="@drawable/redondeado_habitat"
            android:backgroundTint="#388E3C"
            android:gravity="center"
            android:orientation="vertical">
            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Selva" android:textColor="#FFF" android:textStyle="bold"/>
        </LinearLayout>
    </GridLayout>

    <Button
        android:id="@+id/btn_siguiente_animal"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="¡Siguiente Animal!"
        android:backgroundTint="#FFA000"
        android:visibility="gone"
        android:layout_marginTop="10dp"/>

</LinearLayout>