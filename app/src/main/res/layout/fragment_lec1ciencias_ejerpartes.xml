<?xml version="1.0" encoding="utf-8"?>
<FrameLayout
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    xmlns:android="http://schemas.android.com/apk/res/android">

    <ImageView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:alpha="0.8"
        android:src="@drawable/fondoc3"
        android:scaleType="centerCrop"/>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:background="#99000000"
        android:gravity="center"
        android:padding="32dp">

        <TextView
            android:id="@+id/texto_pregunta_cuerpo"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="¿Qué parte del cuerpo es esta?"
            android:textColor="@color/white"
            android:textSize="28sp"
            android:textStyle="bold"
            android:textAlignment="center"
            android:layout_marginBottom="24dp"/>

        <ImageView
            android:id="@+id/imagen_ejercicio_cuerpo"
            android:layout_width="wrap_content"
            android:layout_height="200dp"
            android:adjustViewBounds="true"
            android:src="@drawable/bracillo"
            android:contentDescription="Parte del cuerpo para identificar"
            android:layout_marginBottom="32dp"/>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center">

            <Button
                android:id="@+id/boton_opcion_cuerpo1"
                style="?android:attr/buttonStyleSmall"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Brazo"
                android:textSize="24sp"
                android:layout_marginEnd="16dp"/>

            <Button
                android:id="@+id/boton_opcion_cuerpo2"
                style="?android:attr/buttonStyleSmall"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Boca"
                android:textSize="24sp"
                android:layout_marginEnd="16dp"/>

            <Button
                android:id="@+id/boton_opcion_cuerpo3"
                style="?android:attr/buttonStyleSmall"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginEnd="16dp"
                android:text="Ojo"
                android:textSize="24sp" />

            <Button
                android:id="@+id/boton_opcion_cuerpo4"
                style="?android:attr/buttonStyleSmall"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Pie"
                android:textSize="24sp"/>
        </LinearLayout>

        <Button
            android:id="@+id/boton_siguiente_pregunta"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="32dp"
            android:text="Siguiente Pregunta"
            android:textSize="20sp"/>

    </LinearLayout>

</FrameLayout>