<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <ImageView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:alpha="0.7"
        android:scaleType="centerCrop"
        android:src="@drawable/fondo_ciencias3" />

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:fillViewport="true">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:layout_margin="20dp"
            android:background="#94000000"
            android:orientation="vertical"
            android:padding="20dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="El Hábitat del Pájaro"
                android:textColor="#53E221"
                android:textSize="24sp"
                android:layout_gravity="center"/>

            <ImageView
                android:layout_width="248dp"
                android:layout_height="406dp"
                android:layout_gravity="center"
                android:layout_marginTop="15dp"
                android:src="@drawable/pajaro_nido" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:text="Los árboles son perfectos para hacer nidos y cuidar a sus crías desde las alturas."
                android:textColor="#FFFFFF"
                android:textSize="16sp"
                android:gravity="center" />
        </LinearLayout>
    </ScrollView>
</FrameLayout>