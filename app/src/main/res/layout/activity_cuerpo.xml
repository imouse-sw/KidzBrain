<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/activity_cuerpo"
    android:layout_width="1080px"
    android:layout_height="2000px"
    android:background="@drawable/fondolili">

    <ImageButton
        android:id="@+id/btnSalir"
        android:layout_width="80dp"
        android:layout_height="80dp"
        android:layout_centerHorizontal="true"
        android:layout_marginTop="100dp"
        android:background="@drawable/salir" android:scaleType="fitCenter"
        android:contentDescription="Botón de acción"
        android:elevation="4dp" />

    <LinearLayout
        android:id="@+id/ListaVertical1"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:layout_centerVertical="true"
        android:layout_marginStart="40dp"
        android:paddingTop="10dp"
        android:paddingBottom="10dp">

        <ImageView
            android:id="@+id/recuadroCabello"
            android:layout_width="70dp"
            android:layout_height="70dp"
            android:layout_marginBottom="2dp"
            android:src="@drawable/recuadro" />

        <ImageView
            android:id="@+id/recuadroCejas"
            android:layout_width="70dp"
            android:layout_height="70dp"
            android:layout_marginBottom="2dp"
            android:src="@drawable/recuadro" />

        <ImageView
            android:id="@+id/recuadroOjos"
            android:layout_width="70dp"
            android:layout_height="70dp"
            android:layout_marginBottom="2dp"
            android:src="@drawable/recuadro" />

        <ImageView
            android:id="@+id/recuadroCuello"
            android:layout_width="70dp"
            android:layout_height="70dp"
            android:layout_marginBottom="2dp"
            android:src="@drawable/recuadro" />

        <ImageView
            android:id="@+id/recuadroCodo"
            android:layout_width="70dp"
            android:layout_height="70dp"
            android:layout_marginBottom="2dp"
            android:src="@drawable/recuadro" />

        <ImageView
            android:id="@+id/recuadroTorso"
            android:layout_width="70dp"
            android:layout_height="70dp"
            android:layout_marginBottom="2dp"
            android:src="@drawable/recuadro" />

        <ImageView
            android:id="@+id/recuadroPierna"
            android:layout_width="70dp"
            android:layout_height="70dp"
            android:src="@drawable/recuadro" />

    </LinearLayout>

    <LinearLayout
        android:id="@+id/ListaVertical2"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:layout_centerVertical="true"
        android:layout_marginStart="290dp"
        android:paddingTop="10dp"
        android:paddingBottom="10dp">

        <ImageView
            android:id="@+id/recuadroOreja"
            android:layout_width="70dp"
            android:layout_height="70dp"
            android:layout_marginBottom="2dp"
            android:src="@drawable/recuadro" />

        <ImageView
            android:id="@+id/recuadroNariz"
            android:layout_width="70dp"
            android:layout_height="70dp"
            android:layout_marginBottom="2dp"
            android:src="@drawable/recuadro" />

        <ImageView
            android:id="@+id/recuadroBoca"
            android:layout_width="70dp"
            android:layout_height="70dp"
            android:layout_marginBottom="2dp"
            android:src="@drawable/recuadro" />

        <ImageView
            android:id="@+id/recuadroBrazo"
            android:layout_width="70dp"
            android:layout_height="70dp"
            android:layout_marginBottom="2dp"
            android:src="@drawable/recuadro" />

        <ImageView
            android:id="@+id/recuadroMano"
            android:layout_width="70dp"
            android:layout_height="70dp"
            android:layout_marginBottom="2dp"
            android:src="@drawable/recuadro" />

        <ImageView
            android:id="@+id/recuadroRodilla"
            android:layout_width="70dp"
            android:layout_height="70dp"
            android:layout_marginBottom="2dp"
            android:src="@drawable/recuadro" />

        <ImageView
            android:id="@+id/recuadroPie"
            android:layout_width="70dp"
            android:layout_height="70dp"
            android:src="@drawable/recuadro" />

    </LinearLayout>

    <HorizontalScrollView
        android:id="@+id/scrollImagenes"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="20dp"
        android:paddingStart="10dp"
        android:paddingEnd="10dp"
        android:scrollbars="none">

        <LinearLayout
            android:id="@+id/ListaImagenes"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="horizontal">

            <ImageView
                android:id="@+id/imagenBoca"
                android:layout_width="80dp"
                android:layout_height="80dp"
                android:layout_marginEnd="10dp"
                android:src="@drawable/boca" />

            <ImageView
                android:id="@+id/imagenBrazo"
                android:layout_width="80dp"
                android:layout_height="80dp"
                android:layout_marginEnd="10dp"
                android:src="@drawable/brazo" />

            <ImageView
                android:id="@+id/imagenCabello"
                android:layout_width="80dp"
                android:layout_height="80dp"
                android:layout_marginEnd="10dp"
                android:src="@drawable/cabello" />

            <ImageView
                android:id="@+id/imagenCejas"
                android:layout_width="80dp"
                android:layout_height="80dp"
                android:layout_marginEnd="10dp"
                android:src="@drawable/cejas" />

            <ImageView
                android:id="@+id/imagenMano"
                android:layout_width="80dp"
                android:layout_height="80dp"
                android:layout_marginEnd="10dp"
                android:src="@drawable/mano" />

            <ImageView
                android:id="@+id/imagenNariz"
                android:layout_width="80dp"
                android:layout_height="80dp"
                android:layout_marginEnd="10dp"
                android:src="@drawable/nariz" />

            <ImageView
                android:id="@+id/imagenOjos"
                android:layout_width="80dp"
                android:layout_height="80dp"
                android:layout_marginEnd="10dp"
                android:src="@drawable/ojos" />

        </LinearLayout>

    </HorizontalScrollView>

    <HorizontalScrollView
        android:id="@+id/ImagenesInferior"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_alignParentBottom="true"
        android:layout_marginBottom="20dp"
        android:paddingStart="10dp"
        android:paddingEnd="10dp"
        android:scrollbars="none">

        <LinearLayout
            android:id="@+id/ListaImagenes2"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="horizontal">

            <ImageView
                android:id="@+id/imagenCodo"
                android:layout_width="80dp"
                android:layout_height="80dp"
                android:layout_marginEnd="10dp"
                android:src="@drawable/codo"/>

            <ImageView
                android:id="@+id/imagenCuello"
                android:layout_width="80dp"
                android:layout_height="80dp"
                android:layout_marginEnd="10dp"
                android:src="@drawable/cuello" />

            <ImageView
                android:id="@+id/imagenOreja"
                android:layout_width="80dp"
                android:layout_height="80dp"
                android:layout_marginEnd="10dp"
                android:src="@drawable/oreja" />

            <ImageView
                android:id="@+id/imagenPie"
                android:layout_width="80dp"
                android:layout_height="80dp"
                android:layout_marginEnd="10dp"
                android:src="@drawable/pie" />

            <ImageView
                android:id="@+id/imagenPierna"
                android:layout_width="80dp"
                android:layout_height="80dp"
                android:layout_marginEnd="10dp"
                android:src="@drawable/pierna" />

            <ImageView
                android:id="@+id/imagenRodilla"
                android:layout_width="80dp"
                android:layout_height="80dp"
                android:layout_marginEnd="10dp"
                android:src="@drawable/rodilla" />

            <ImageView
                android:id="@+id/imagenTorso"
                android:layout_width="80dp"
                android:layout_height="80dp"
                android:layout_marginEnd="10dp"
                android:src="@drawable/torso" />

        </LinearLayout>
    </HorizontalScrollView>

</RelativeLayout>
