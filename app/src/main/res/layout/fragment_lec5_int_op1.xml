<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/background_math_intermediate">

    <View
        android:layout_width="180dp"
        android:layout_height="180dp"
        android:background="@drawable/deco_circle_green"
        android:alpha="0.6"
        android:layout_marginTop="-40dp"
        android:layout_marginEnd="-40dp"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <View
        android:layout_width="120dp"
        android:layout_height="120dp"
        android:background="@drawable/deco_circle_yellow"
        android:alpha="0.6"
        android:layout_marginBottom="50dp"
        android:layout_marginStart="-30dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent" />

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toBottomOf="parent"
        android:paddingHorizontal="24dp"
        android:clipToPadding="false">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingTop="80dp"
            android:paddingBottom="40dp"
            android:gravity="center_horizontal">

            <androidx.cardview.widget.CardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                app:cardCornerRadius="20dp"
                app:cardElevation="8dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="24dp"
                    android:gravity="center_horizontal"
                    android:background="@drawable/card_math_intermediate_background">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Calcula el Perímetro"
                        android:fontFamily="@font/syne"
                        android:textSize="22sp"
                        android:textStyle="bold"
                        android:textColor="#2D3E50"
                        android:layout_marginBottom="4dp"/>

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Suma todos los lados (6m y 4m)"
                        android:fontFamily="@font/syne"
                        android:textColor="#2D3E50"
                        android:textSize="16sp"
                        android:layout_marginBottom="24dp"/>

                    <androidx.constraintlayout.widget.ConstraintLayout
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginBottom="24dp">

                        <ImageView
                            android:id="@+id/img_jardin_perimetro"
                            android:layout_width="250dp"
                            android:layout_height="170dp"
                            android:src="@drawable/cerca"
                            android:scaleType="fitCenter"
                            app:layout_constraintTop_toTopOf="parent"
                            app:layout_constraintStart_toStartOf="parent"
                            app:layout_constraintEnd_toEndOf="parent"
                            app:layout_constraintBottom_toBottomOf="parent"/>

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="6 m"
                            android:fontFamily="@font/syne"
                            android:textColor="#3A7BD5"
                            android:textSize="20sp"
                            android:textStyle="bold"
                            android:background="#F0F8FF"
                            android:paddingHorizontal="4dp"
                            app:layout_constraintTop_toTopOf="@+id/img_jardin_perimetro"
                            app:layout_constraintStart_toStartOf="@+id/img_jardin_perimetro"
                            app:layout_constraintEnd_toEndOf="@+id/img_jardin_perimetro" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="6 m"
                            android:fontFamily="@font/syne"
                            android:textColor="#3A7BD5"
                            android:textSize="20sp"
                            android:textStyle="bold"
                            android:background="#F0F8FF"
                            android:paddingHorizontal="4dp"
                            app:layout_constraintBottom_toBottomOf="@+id/img_jardin_perimetro"
                            app:layout_constraintStart_toStartOf="@+id/img_jardin_perimetro"
                            app:layout_constraintEnd_toEndOf="@+id/img_jardin_perimetro" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="4 m"
                            android:fontFamily="@font/syne"
                            android:textColor="#3A7BD5"
                            android:textSize="20sp"
                            android:textStyle="bold"
                            android:background="#F0F8FF"
                            android:paddingVertical="4dp"
                            app:layout_constraintStart_toStartOf="@+id/img_jardin_perimetro"
                            app:layout_constraintTop_toTopOf="@+id/img_jardin_perimetro"
                            app:layout_constraintBottom_toBottomOf="@+id/img_jardin_perimetro" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="4 m"
                            android:fontFamily="@font/syne"
                            android:textColor="#3A7BD5"
                            android:textSize="20sp"
                            android:textStyle="bold"
                            android:background="#F0F8FF"
                            android:paddingVertical="4dp"
                            app:layout_constraintEnd_toEndOf="@+id/img_jardin_perimetro"
                            app:layout_constraintTop_toTopOf="@+id/img_jardin_perimetro"
                            app:layout_constraintBottom_toBottomOf="@+id/img_jardin_perimetro" />

                    </androidx.constraintlayout.widget.ConstraintLayout>

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:gravity="center"
                        android:orientation="horizontal">

                        <Button
                            android:id="@+id/btn_opcion_incorrecta1"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="10 m"
                            android:fontFamily="@font/syne"
                            android:backgroundTint="#3A60D5"
                            android:textColor="#FFFFFF"/>
                        <Button
                            android:id="@+id/btn_opcion_incorrecta2"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="24 m"
                            android:fontFamily="@font/syne"
                             android:backgroundTint="#3A60D5"
                            android:textColor="#FFFFFF"/>
                        <Button
                            android:id="@+id/btn_opcion_correcta"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="20 m"
                            android:fontFamily="@font/syne"
                             android:backgroundTint="#3A60D5"
                            android:textColor="#FFFFFF"/>
                    </LinearLayout>

                </LinearLayout>
            </androidx.cardview.widget.CardView>

        </LinearLayout>
    </ScrollView>

</androidx.constraintlayout.widget.ConstraintLayout>