<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true"
    android:background="#FFF3E0">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:gravity="center_horizontal"
        android:padding="20dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Calcula el Perímetro"
            android:textColor="#E65100"
            android:textSize="26sp"
            android:textStyle="bold"
            android:layout_marginBottom="10dp"/>

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Suma todos los lados (6m y 4m)"
            android:textSize="16sp"
            android:layout_marginBottom="30dp"/>

        <androidx.constraintlayout.widget.ConstraintLayout
            android:layout_width="395dp"
            android:layout_height="236dp"
            android:layout_marginBottom="40dp">

            <ImageView
                android:id="@+id/img_jardin_perimetro"
                android:layout_width="207dp"
                android:layout_height="117dp"
                android:background="#8D6E63"
                android:contentDescription="Jardín rectangular"
                android:scaleType="centerCrop"
                android:src="@drawable/cerca"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginBottom="5dp"
                android:text="6 m"
                android:textSize="20sp"
                android:textStyle="bold"
                app:layout_constraintBottom_toTopOf="@+id/img_jardin_perimetro"
                app:layout_constraintEnd_toEndOf="@+id/img_jardin_perimetro"
                app:layout_constraintStart_toStartOf="@+id/img_jardin_perimetro" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="5dp"
                android:text="6 m"
                android:textSize="20sp"
                android:textStyle="bold"
                app:layout_constraintEnd_toEndOf="@+id/img_jardin_perimetro"
                app:layout_constraintStart_toStartOf="@+id/img_jardin_perimetro"
                app:layout_constraintTop_toBottomOf="@+id/img_jardin_perimetro" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginEnd="10dp"
                android:text="4 m"
                android:textSize="20sp"
                android:textStyle="bold"
                app:layout_constraintBottom_toBottomOf="@+id/img_jardin_perimetro"
                app:layout_constraintEnd_toStartOf="@+id/img_jardin_perimetro"
                app:layout_constraintTop_toTopOf="@+id/img_jardin_perimetro" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="10dp"
                android:text="4 m"
                android:textSize="20sp"
                android:textStyle="bold"
                app:layout_constraintBottom_toBottomOf="@+id/img_jardin_perimetro"
                app:layout_constraintStart_toEndOf="@+id/img_jardin_perimetro"
                app:layout_constraintTop_toTopOf="@+id/img_jardin_perimetro" />

        </androidx.constraintlayout.widget.ConstraintLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:orientation="horizontal">

            <Button
                android:id="@+id/btn_opcion_incorrecta1"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="10 m"
                android:layout_margin="10dp"/>
            <Button
                android:id="@+id/btn_opcion_incorrecta2"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="24 m"
                android:layout_margin="10dp"/>
            <Button
                android:id="@+id/btn_opcion_correcta"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="20 m"
                android:layout_margin="10dp"/>
        </LinearLayout>
    </LinearLayout>
</ScrollView>