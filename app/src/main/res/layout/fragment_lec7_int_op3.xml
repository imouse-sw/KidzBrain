<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true"
    android:background="#F3E5F5">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:gravity="center_horizontal"
        android:padding="20dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="¡A pagar en la tiendita!"
            android:textColor="#7B1FA2"
            android:textSize="22sp"
            android:textStyle="bold"
            android:layout_marginBottom="10dp"/>

        <TextView
            android:id="@+id/txt_pregunta_decimal"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="¿Cuánto es $10.50 + $3.25?"
            android:textSize="20sp"
            android:layout_marginBottom="30dp"
            android:textAlignment="center"/>

        <ImageView
            android:id="@+id/img_dinero_decimal"
            android:layout_width="200dp"
            android:layout_height="200dp"
            android:layout_marginBottom="30dp"
            android:scaleType="fitCenter"/>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:orientation="horizontal">

            <Button
                android:id="@+id/btn_d_op0"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="$15.50"
                android:layout_margin="5dp"
                android:backgroundTint="#9C27B0"/>

            <Button
                android:id="@+id/btn_d_op1"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="$13.25"
                android:layout_margin="5dp"
                android:backgroundTint="#9C27B0"/>

            <Button
                android:id="@+id/btn_d_op2"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="$13.75"
                android:layout_margin="5dp"
                android:backgroundTint="#9C27B0"/>
        </LinearLayout>
    </LinearLayout>
</ScrollView>