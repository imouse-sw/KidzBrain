<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <ImageView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:alpha="0.7"
        android:scaleType="centerCrop"
        android:src="@drawable/fondo_salud" />

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:fillViewport="true">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:layout_margin="20dp"
            android:background="#94000000"
            android:orientation="vertical"
            android:padding="20dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Escudo contra enfermedades"
                android:textColor="#BA68C8"
                android:textSize="22sp"
                android:textStyle="bold"
                android:layout_gravity="center"/>

            <ImageView
                android:layout_width="309dp"
                android:layout_height="387dp"
                android:layout_gravity="center"
                android:layout_marginTop="10dp"
                android:src="@drawable/alimentos_proteger" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="15dp"
                android:text="Las frutas y verduras tienen vitaminas que cuidan tu piel, tus ojos y tu digestión."
                android:textColor="#DDDDDD"
                android:textSize="18sp"
                android:gravity="center" />
        </LinearLayout>
    </ScrollView>
</FrameLayout>