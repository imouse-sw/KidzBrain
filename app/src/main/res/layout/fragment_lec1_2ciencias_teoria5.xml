<?xml version="1.0" encoding="utf-8"?>
<FrameLayout
    android:layout_width="match_parent"
    android:layout_height="match_parent" xmlns:android="http://schemas.android.com/apk/res/android">

    <ImageView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:scaleType="centerCrop"
        android:background="#BADFC0"
        android:src="@drawable/fondoc5" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_margin="20dp" android:orientation="vertical"
        android:gravity="center"
        android:padding="5dp">

        <ImageView
            android:layout_width="155dp"
            android:layout_height="132dp"
            android:layout_marginTop="10dp"
            android:src="@drawable/bokilla" />

        <ImageView
            android:layout_width="169dp"
            android:layout_height="140dp"
            android:layout_marginTop="15dp"
            android:src="@drawable/paleta" />

        <ImageView
            android:layout_width="180dp" android:layout_height="160dp" android:layout_marginTop="15dp" android:src="@drawable/papitas" />

        <LinearLayout
            android:layout_width="389dp"
            android:layout_height="177dp"
            android:layout_marginTop="15dp"
            android:gravity="center"
            android:orientation="horizontal">

            <ImageView
                android:layout_width="163dp"
                android:layout_height="148dp"
                android:layout_marginEnd="10dp"
                android:src="@drawable/limon1" />

            <ImageView
                android:layout_width="163dp"
                android:layout_height="143dp"
                android:src="@drawable/tor" />
        </LinearLayout>

    </LinearLayout>

</FrameLayout>