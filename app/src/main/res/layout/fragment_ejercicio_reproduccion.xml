<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true"
    android:background="#121212">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="20dp"
        android:gravity="center_horizontal">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_marginBottom="20dp">

            <TextView
                android:id="@+id/txt_puntos_repro"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="PUNTOS: 0"
                android:textColor="#4CAF50"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/txt_progreso_repro"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="ANÁLISIS 1/8"
                android:textColor="#03A9F4" />
        </LinearLayout>

        <TextView
            android:id="@+id/txt_titulo_repro"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="LABORATORIO DE BIOSISTEMAS"
            android:textColor="#FFFFFF"
            android:textSize="20sp"
            android:textStyle="bold"
            android:layout_marginBottom="25dp"/>

        <androidx.cardview.widget.CardView
            android:layout_width="300dp"
            android:layout_height="220dp"
            app:cardCornerRadius="15dp"
            app:cardBackgroundColor="#1E1E1E"
            android:layout_marginBottom="20dp">

            <ImageView
                android:id="@+id/img_repro_pregunta"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:padding="15dp"
                android:scaleType="fitCenter" />
        </androidx.cardview.widget.CardView>

        <TextView
            android:id="@+id/txt_descripcion_repro"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Identifica el proceso o estructura biológica:"
            android:textColor="#B0B0B0"
            android:textSize="16sp"
            android:gravity="center"
            android:layout_marginBottom="25dp"/>

        <LinearLayout
            android:id="@+id/layout_controles_repro"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <Button
                android:id="@+id/btn_repro_op0"
                style="@style/Widget.MaterialComponents.Button.OutlinedButton"
                android:layout_width="match_parent"
                android:layout_height="60dp"
                android:layout_marginVertical="5dp"
                android:textColor="#03A9F4"
                app:strokeColor="#03A9F4"
                app:strokeWidth="2dp" />

            <Button
                android:id="@+id/btn_repro_op1"
                style="@style/Widget.MaterialComponents.Button.OutlinedButton"
                android:layout_width="match_parent"
                android:layout_height="60dp"
                android:layout_marginVertical="5dp"
                android:textColor="#03A9F4"
                app:strokeColor="#03A9F4"
                app:strokeWidth="2dp" />

            <Button
                android:id="@+id/btn_repro_op2"
                style="@style/Widget.MaterialComponents.Button.OutlinedButton"
                android:layout_width="match_parent"
                android:layout_height="60dp"
                android:layout_marginVertical="5dp"
                android:textColor="#03A9F4"
                app:strokeColor="#03A9F4"
                app:strokeWidth="2dp" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/layout_final_repro"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:visibility="gone"
            android:gravity="center">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="ANÁLISIS FINALIZADO"
                android:textColor="#4CAF50"
                android:textSize="22sp"
                android:textStyle="bold" />

            <Button
                android:id="@+id/btn_repro_reiniciar"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="20dp"
                android:text="REINICIAR SIMULACIÓN"
                android:backgroundTint="#3F51B5" />
        </LinearLayout>
    </LinearLayout>
</ScrollView>