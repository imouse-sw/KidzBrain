<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <ImageView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:alpha="0.7"
        android:scaleType="centerCrop"
        android:src="@drawable/fondo_ciencias3" />

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:fillViewport="true">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:layout_margin="20dp"
            android:background="#94000000"
            android:orientation="vertical"
            android:padding="25dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center"
                android:text="El Hábitat del Pez"
                android:textColor="#2196F3"
                android:textSize="24sp"
                android:textStyle="bold"/>

            <ImageView
                android:layout_width="337dp"
                android:layout_height="363dp"
                android:layout_marginTop="20dp"
                android:layout_gravity="center"
                android:src="@drawable/pez_oceano" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="15dp"
                android:text="El agua es su hogar. En el océano puede nadar y encontrar su alimento fácilmente."
                android:textColor="#DDDDDD"
                android:textSize="16sp"
                android:gravity="center" />

        </LinearLayout>
    </ScrollView>
</FrameLayout>