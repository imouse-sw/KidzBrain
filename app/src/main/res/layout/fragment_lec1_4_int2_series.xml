<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/background_main">

    <TextView
        android:id="@+id/titulo_ejercicio_2"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="¿Qué número sigue?"
        android:fontFamily="@font/syne"
        android:textSize="26sp"
        android:textStyle="bold"
        android:textColor="#FFFFFF"
        android:layout_marginTop="60dp"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <androidx.cardview.widget.CardView
        android:id="@+id/card_pregunta_2"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginHorizontal="24dp"
        android:layout_marginTop="32dp"
        app:cardCornerRadius="25dp"
        app:layout_constraintTop_toBottomOf="@id/titulo_ejercicio_2">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="300dp"
            android:orientation="vertical"
            android:padding="30dp"
            android:gravity="center"
            android:background="@drawable/card_materia_math">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="2 - 4 - 6 - 8 - ?"
                android:textColor="#FFFFFF"
                android:fontFamily="@font/syne"
                android:textSize="32sp"
                android:textStyle="bold"
                android:layout_marginBottom="16dp"/>
            
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="¡Descartes dice que sumemos 2!"
                android:textColor="#EEEEEE"
                android:fontFamily="@font/syne"
                android:textSize="16sp"/>
        </LinearLayout>
    </androidx.cardview.widget.CardView>

    <GridLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:columnCount="2"
        android:rowCount="1"
        android:padding="20dp"
        app:layout_constraintTop_toBottomOf="@id/card_pregunta_2"
        app:layout_constraintBottom_toBottomOf="parent">

        <Button
            android:id="@+id/btn_opcion_9"
            android:layout_width="0dp"
            android:layout_height="80dp"
            android:layout_columnWeight="1"
            android:layout_margin="10dp"
            android:text="9"
            android:backgroundTint="#FF9800"
            android:textColor="#FFFFFF"
            android:fontFamily="@font/syne"
            android:textSize="24sp"/>

        <Button
            android:id="@+id/btn_opcion_10"
            android:layout_width="0dp"
            android:layout_height="80dp"
            android:layout_columnWeight="1"
            android:layout_margin="10dp"
            android:text="10"
            android:backgroundTint="#4CAF50"
            android:textColor="#FFFFFF"
            android:fontFamily="@font/syne"
            android:textSize="24sp"/>
    </GridLayout>

</androidx.constraintlayout.widget.ConstraintLayout>