<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <ImageView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:alpha="0.7"
        android:scaleType="centerCrop"
        android:src="@drawable/fondo_ciencias5" />

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:fillViewport="true">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:layout_margin="20dp"
            android:background="#B3000000"
            android:orientation="vertical"
            android:padding="25dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="CIENCIA AVANZADA"
                android:textColor="#4CAF50"
                android:textSize="14sp"
                android:textStyle="bold"
                android:layout_gravity="center"/>

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="La Continuidad de la Vida"
                android:textColor="#FFFFFF"
                android:textSize="26sp"
                android:textStyle="bold"
                android:layout_gravity="center"
                android:gravity="center"/>

            <View
                android:layout_width="100dp"
                android:layout_height="2dp"
                android:background="#4CAF50"
                android:layout_gravity="center"
                android:layout_marginTop="10dp"/>

            <ImageView
                android:layout_width="258dp"
                android:layout_height="248dp"
                android:layout_gravity="center"
                android:layout_marginTop="20dp"
                android:src="@drawable/bb_feliz" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="20dp"
                android:text="Hola, explorador. Hoy analizaremos cómo la vida se abre paso a través de la reproducción en plantas y animales."
                android:textColor="#E0E0E0"
                android:textSize="18sp"
                android:lineSpacingExtra="4sp"
                android:gravity="center" />
        </LinearLayout>
    </ScrollView>
</FrameLayout>