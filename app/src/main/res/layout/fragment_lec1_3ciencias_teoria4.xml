<?xml version="1.0" encoding="utf-8"?>
<FrameLayout
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    xmlns:android="http://schemas.android.com/apk/res/android">

    <ImageView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:alpha="0.8"
        android:scaleType="centerCrop"
        android:src="@drawable/fondo_ciencias3" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="#94000000"
        android:orientation="vertical"
        android:gravity="center">

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:text="Tipos de contenedores"
            android:textColor="#39FF14"
            android:fontFamily="@font/font"
            android:textSize="60sp"
            android:layout_marginBottom="20dp" />

        <ImageView
            android:layout_width="170dp"
            android:layout_height="170dp"
            android:src="@drawable/basurainornorec"
            android:layout_marginBottom="10dp"
            android:scaleType="fitCenter"
            android:adjustViewBounds="true" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center">

            <ImageView
                android:layout_width="170dp"
                android:layout_height="170dp"
                android:src="@drawable/basuraorganica"
                android:layout_marginEnd="10dp"
                android:scaleType="fitCenter"
                android:adjustViewBounds="true" />

            <ImageView
                android:layout_width="170dp"
                android:layout_height="170dp"
                android:src="@drawable/basurarec"
                android:layout_marginStart="10dp"
                android:scaleType="fitCenter"
                android:adjustViewBounds="true" />

        </LinearLayout>

    </LinearLayout>

</FrameLayout>