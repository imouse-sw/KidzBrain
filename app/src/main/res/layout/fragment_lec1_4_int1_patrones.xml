<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/background_main">

    <TextView
        android:id="@+id/titulo_ejercicio"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="¿Qué color sigue?"
        android:fontFamily="@font/syne"
        android:textSize="26sp"
        android:textStyle="bold"
        android:textColor="#FFFFFF"
        android:layout_marginTop="60dp"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <androidx.cardview.widget.CardView
        android:id="@+id/card_pregunta"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginHorizontal="24dp"
        android:layout_marginTop="32dp"
        app:cardCornerRadius="25dp"
        app:layout_constraintTop_toBottomOf="@id/titulo_ejercicio">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="20dp"
            android:gravity="center"
            android:background="@drawable/card_materia_math">

            <ImageView
                android:layout_width="match_parent"
                android:layout_height="200dp"
                android:src="@drawable/patron_colores"
                android:scaleType="fitCenter"/>
            
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Observa el orden y elige:"
                android:textColor="#FFFFFF"
                android:fontFamily="@font/syne"
                android:layout_marginTop="16dp"/>
        </LinearLayout>
    </androidx.cardview.widget.CardView>

    <GridLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:columnCount="2"
        android:rowCount="1"
        android:padding="20dp"
        app:layout_constraintTop_toBottomOf="@id/card_pregunta"
        app:layout_constraintBottom_toBottomOf="parent">

        <androidx.appcompat.widget.AppCompatButton
            android:id="@+id/btn_opcion_rojo"
            android:layout_width="0dp"
            android:layout_height="80dp"
            android:layout_columnWeight="1"
            android:background="@drawable/btn_pixel_style"
            android:layout_margin="10dp"
            android:text="ROJO"
            android:backgroundTint="#57FF0000"
            android:textColor="#FFFFFF"
            android:fontFamily="@font/syne"
            android:textSize="18sp"/>

        <androidx.appcompat.widget.AppCompatButton
            android:id="@+id/btn_opcion_azul"
            android:layout_width="0dp"
            android:layout_height="80dp"
            android:layout_columnWeight="1"
            android:background="@drawable/btn_pixel_style"
            android:layout_margin="10dp"
            android:text="AZUL"
            android:backgroundTint="#570040FF"
            android:textColor="#FFFFFF"
            android:fontFamily="@font/syne"
            android:textSize="18sp"/>
    </GridLayout>

</androidx.constraintlayout.widget.ConstraintLayout>