<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    tools:context="com.kidzbrain.juegos.multiplosdivisores.MultiplosDivisores">

    <ImageView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:alpha="0.6"
        android:scaleType="centerCrop"
        android:src="@drawable/px_fondo_feria" />

    <FrameLayout
        android:id="@+id/contenedorGlobos"
        android:layout_width="match_parent"
        android:layout_height="match_parent" >

        <TextView
            android:id="@+id/txtContador"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:background="#9A000000"
            android:fontFamily="@font/syne"
            android:text="Siguiente misión en: 5 globos"
            android:textSize="18sp"
            android:textStyle="bold"
            android:textColor="@color/white"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            android:layout_marginTop="150dp"
            android:layout_marginStart="17dp"
            app:layout_constraintTop_toBottomOf="@id/txtMision" />
    </FrameLayout>

    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:padding="16dp">

        <LinearLayout
            android:id="@+id/panelPuntuacion"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="#9A000000"
            android:orientation="horizontal"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintStart_toStartOf="parent">

            <ImageButton
                android:id="@+id/btnBack"
                android:layout_width="46dp"
                android:layout_height="46dp"
                android:background="@android:color/transparent"
                android:src="@drawable/ic_back_white"
                android:contentDescription="Regresar"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent" />

            <TextView
            android:id="@+id/txtPuntuacion"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:layout_marginStart="220dp"
            android:fontFamily="@font/syne"
            android:text="Puntos: 0"
            android:textColor="@color/white"
            android:textSize="18sp"
            android:textStyle="bold" />
        </LinearLayout>

        <TextView
            android:id="@+id/txtMision"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:background="#9A000000"
            android:fontFamily="@font/syne"
            android:gravity="center"
            android:padding="10dp"
            android:text="¡Atrapa los múltiplos de 5!"
            android:textColor="@color/white"
            android:textSize="24sp"
            android:textStyle="bold"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/panelPuntuacion" />

        <ImageView
            android:id="@+id/img_payaso"
            android:layout_width="150dp"
            android:layout_height="150dp"
            android:scaleType="fitXY"
            android:src="@drawable/bb_px_payaso"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent" />

        <TextView
            android:id="@+id/txtFeedback"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:fontFamily="@font/syne"
            android:text=""
            android:background="#9A000000"
            android:textColor="#FFFFFF"
            android:textSize="22sp"
            android:textStyle="bold|italic"
            app:layout_constraintEnd_toStartOf="@id/img_payaso"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintBottom_toBottomOf="parent"
            android:layout_marginStart="100dp"
            android:layout_marginBottom="50dp"/>

        <ImageView
            android:id="@+id/img_cliente"
            android:layout_width="70dp"
            android:layout_height="100dp"
            android:scaleType="fitXY"
            android:src="@drawable/px_cliente"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toStartOf="@id/txtFeedback"
            app:layout_constraintStart_toStartOf="parent"
            android:layout_marginStart="-80dp"/>

    </androidx.constraintlayout.widget.ConstraintLayout>

    <LinearLayout
        android:id="@+id/panelTutorial"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="#D9000000"
        android:gravity="center"
        android:orientation="vertical"
        android:padding="24dp"
        android:visibility="visible"
        android:elevation="10dp">

        <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@drawable/panel_pixel_style"
        android:gravity="center"
        android:orientation="vertical"
        android:padding="24dp">

        <ImageView
            android:layout_width="80dp"
            android:layout_height="80dp"
            android:src="@drawable/bb_px_payaso_feliz" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:fontFamily="@font/syne"
            android:gravity="center"
            android:text="¡Pon atención a la misión en la parte superior para que sepas qué números atrapar!"
            android:textColor="#442434"
            android:textSize="20sp"
            android:textStyle="bold" />

        <androidx.appcompat.widget.AppCompatButton
            android:id="@+id/btnEntendido"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:background="@drawable/btn_pixel_style"
            android:backgroundTint="@null"
            android:fontFamily="@font/syne"
            android:text="¡Entendido!"
            android:textColor="#FFFFFF"
            android:textStyle="bold" />
    </LinearLayout>
    </LinearLayout>

</FrameLayout>