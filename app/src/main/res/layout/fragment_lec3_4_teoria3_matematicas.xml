<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/background_math_advanced">

    <View
        android:layout_width="150dp"
        android:layout_height="150dp"
        android:background="@drawable/deco_circle_pink"
        android:alpha="0.3"
        android:layout_marginTop="-20dp"
        android:layout_marginEnd="-20dp"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:paddingHorizontal="24dp"
        android:clipToPadding="false">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingTop="60dp"
            android:paddingBottom="40dp"
            android:gravity="center_horizontal">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="¿Cómo se calcula?"
                android:fontFamily="@font/syne"
                android:textSize="26sp"
                android:textStyle="bold"
                android:textColor="#FFFFFF"
                android:layout_marginBottom="24dp"/>

            <androidx.cardview.widget.CardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                app:cardCornerRadius="25dp"
                app:cardElevation="10dp"
                android:layout_marginBottom="20dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="24dp"
                    android:gravity="center_horizontal"
                    android:background="@drawable/card_materia_math">

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="Para saber la probabilidad, usamos una fracción: \n\nProbabilidad = Casos Favorables / Casos Totales \n\nSi una ruleta tiene 4 partes y 1 es roja, la probabilidad de que salga rojo es 1 de 4 (1/4)."
                        android:fontFamily="@font/syne"
                        android:textSize="17sp"
                        android:textColor="#FFFFFF"
                        android:gravity="center"
                        android:lineSpacingExtra="5dp"
                        android:layout_marginBottom="20dp"/>

                    <ImageView
                        android:layout_width="match_parent"
                        android:layout_height="150dp"
                        android:src="@drawable/prob_ruleta"
                        android:scaleType="fitCenter"/>

                </LinearLayout>
            </androidx.cardview.widget.CardView>

            <ImageView
                android:layout_width="140dp"
                android:layout_height="140dp"
                android:src="@drawable/bb_feliz"
                android:scaleType="fitCenter"/>

        </LinearLayout>
    </ScrollView>
</androidx.constraintlayout.widget.ConstraintLayout>