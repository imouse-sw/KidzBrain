<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:gravity="center_horizontal"
    android:padding="20dp"
    android:background="#E1F5FE">

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Reparte las galletas (24 ÷ 3)"
        android:textSize="20sp"
        android:textStyle="bold"
        android:gravity="center"
        android:layout_marginBottom="10dp"/>

    <TextView
        android:id="@+id/txt_contador_global"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Repartidas: 0 / 24"
        android:textSize="18sp"
        android:layout_marginBottom="20dp"/>

    <ImageView
        android:id="@+id/img_monton_galletas"
        android:layout_width="140dp"
        android:layout_height="140dp"
        android:layout_marginBottom="30dp"
        android:scaleType="fitCenter"
        android:src="@drawable/galletas5"
        android:contentDescription="Montón de galletas" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:baselineAligned="false"
        android:gravity="center">

        <LinearLayout
            android:layout_width="0dp"
            android:layout_weight="1"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:gravity="center">

            <ImageView
                android:layout_width="90dp"
                android:layout_height="110dp"
                android:src="@drawable/nino" />

            <TextView
                android:id="@+id/txt_cuenta_amigo1"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="0"
                android:textSize="28sp"
                android:textStyle="bold"/>

            <Button
                android:id="@+id/btn_dar_1"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="+1"
                android:textSize="16sp"
                android:backgroundTint="#4CAF50"/>
        </LinearLayout>

        <LinearLayout
            android:layout_width="0dp"
            android:layout_weight="1"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:gravity="center">

            <ImageView
                android:layout_width="90dp"
                android:layout_height="110dp"
                android:src="@drawable/nino" />

            <TextView
                android:id="@+id/txt_cuenta_amigo2"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="0"
                android:textSize="28sp"
                android:textStyle="bold"/>

            <Button
                android:id="@+id/btn_dar_2"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="+1"
                android:textSize="16sp"
                android:backgroundTint="#4CAF50"/>
        </LinearLayout>

        <LinearLayout
            android:layout_width="0dp"
            android:layout_weight="1"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:gravity="center">

            <ImageView
                android:layout_width="90dp"
                android:layout_height="110dp"
                android:src="@drawable/nino"/>

            <TextView
                android:id="@+id/txt_cuenta_amigo3"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="0"
                android:textSize="28sp"
                android:textStyle="bold"/>

            <Button
                android:id="@+id/btn_dar_3"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="+1"
                android:textSize="16sp"
                android:backgroundTint="#4CAF50"/>
        </LinearLayout>

    </LinearLayout>

</LinearLayout>