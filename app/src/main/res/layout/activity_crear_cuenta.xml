<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/background_main"
    android:fitsSystemWindows="true"
    tools:context=".CrearCuentaActivity">

    <!-- === DECORACIÓN DE FONDO === -->
    <View
        android:layout_width="200dp"
        android:layout_height="200dp"
        android:background="@drawable/deco_circle_pink"
        android:alpha="0.6"
        android:layout_marginTop="-50dp"
        android:layout_marginStart="-50dp"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent" />

    <View
        android:layout_width="150dp"
        android:layout_height="150dp"
        android:background="@drawable/deco_circle_yellow"
        android:alpha="0.8"
        android:layout_marginBottom="100dp"
        android:layout_marginEnd="-40dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <!-- === TARJETA DE REGISTRO === -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:background="@drawable/card_background"
        android:padding="32dp"
        android:elevation="16dp"
        android:layout_marginHorizontal="24dp"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toBottomOf="parent">

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Crear Nueva Cuenta"
            android:fontFamily="@font/syne"
            android:textSize="26sp"
            android:textColor="#2D3E50"
            android:textStyle="bold"
            android:gravity="center"
            android:layout_marginBottom="24dp"/>

        <!-- CAMPO NOMBRE -->
        <EditText
            android:id="@+id/et_nombre_registro"
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:background="@drawable/input_background"
            android:hint="Nombre"
            android:paddingHorizontal="20dp"
            android:fontFamily="@font/syne"
            android:textColor="#333"
            android:textColorHint="#90A4AE"
            android:inputType="textPersonName"
            android:layout_marginBottom="16dp"/>

        <!-- CAMPO CORREO -->
        <EditText
            android:id="@+id/et_email_registro"
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:background="@drawable/input_background"
            android:hint="Correo electrónico"
            android:paddingHorizontal="20dp"
            android:fontFamily="@font/syne"
            android:textColor="#333"
            android:textColorHint="#90A4AE"
            android:inputType="textEmailAddress"
            android:layout_marginBottom="16dp"/>

        <!-- CAMPO PASSWORD -->
        <EditText
            android:id="@+id/et_password_registro"
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:background="@drawable/input_background"
            android:hint="Contraseña"
            android:paddingHorizontal="20dp"
            android:fontFamily="@font/syne"
            android:textColor="#333"
            android:textColorHint="#90A4AE"
            android:inputType="textPassword"
            android:layout_marginBottom="16dp"/>

        <!-- CAMPO FECHA DE NACIMIENTO -->
        <TextView
            android:id="@+id/tv_fecha_nacimiento"
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:background="@drawable/input_background"
            android:hint="Fecha de nacimiento"
            android:paddingHorizontal="20dp"
            android:fontFamily="@font/syne"
            android:textColor="#333"
            android:gravity="center_vertical"
            android:textSize="18sp"
            android:textColorHint="#90A4AE"
            android:clickable="true"
            android:focusable="true"
            android:layout_marginBottom="24dp"/>

        <!-- BOTÓN REGISTRARSE -->
        <androidx.appcompat.widget.AppCompatButton
            android:id="@+id/btn_registrar"
            android:layout_width="match_parent"
            android:layout_height="60dp"
            android:text="REGISTRARSE"
            android:fontFamily="@font/syne"
            android:textSize="18sp"
            android:textStyle="bold"
            android:textColor="#FFFFFF"
            android:background="@drawable/button_background"
            android:stateListAnimator="@null"/>

        <!-- TEXTO VOLVER -->
        <TextView
            android:id="@+id/tv_volver_login"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="¿Ya tienes cuenta? Inicia sesión"
            android:fontFamily="@font/syne"
            android:textColor="#D372A3"
            android:textStyle="bold"
            android:layout_gravity="center"
            android:padding="12dp"
            android:layout_marginTop="12dp"/>

    </LinearLayout>

</androidx.constraintlayout.widget.ConstraintLayout>