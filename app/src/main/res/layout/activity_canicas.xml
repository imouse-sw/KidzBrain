<?xml version="1.0" encoding="utf-8"?>
<FrameLayout
    android:layout_width="match_parent"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_height="match_parent"
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    tools:context="com.kidzbrain.juegos.canicas.Canicas"
    android:id="@+id/main">
    
    <ImageView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:src="@drawable/bg_canicas"
        android:alpha="0.6"
        android:scaleType="centerCrop"/>


    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="#94000000"
        android:padding="16dp">

        <ImageButton
            android:id="@+id/btnBack"
            android:layout_width="46dp"
            android:layout_height="46dp"
            android:background="@android:color/transparent"
            android:src="@drawable/ic_back_white"
            android:contentDescription="Regresar"/>

        <TextView
            android:id="@+id/txt_problemita"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="3 + 4 = ?"
            android:textSize="34sp"
            android:textStyle="bold"
            android:fontFamily="@font/syne"
            android:textColor="@color/white"
            android:layout_marginTop="50dp"
            android:inputType="number"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent" />

        <EditText
            android:layout_width="300dp"
            android:id="@+id/txt_respuesta"
            android:layout_height="wrap_content"
            android:hint="Escribe tu respuesta..."
            android:gravity="center"
            android:textColor="@color/white"
            android:maxLength="2"
            android:fontFamily="@font/syne"
            android:textColorHint="#A9A9A9"
            app:layout_constraintTop_toBottomOf="@id/txt_problemita"
            app:layout_constraintBottom_toTopOf="@id/botes_container"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent"/>

        <LinearLayout
            android:id="@+id/botes_container"
            android:layout_width="0dp"
            android:layout_height="250dp"
            android:gravity="center"
            android:orientation="horizontal"
            app:layout_constraintBottom_toTopOf="@id/btn_respuesta"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/txt_respuesta">

            <GridLayout
                android:id="@+id/bote_1"
                android:layout_width="160dp"
                android:layout_height="200dp"
                android:layout_margin="8dp"
                android:background="@drawable/bote_canicas"
                android:columnCount="4"/>

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="+"
                android:textColor="@color/white"
                android:fontFamily="casual"
                android:textSize="40sp"
                android:textStyle="bold" />

            <GridLayout
                android:id="@+id/bote_2"
                android:layout_width="160dp"
                android:layout_height="200dp"
                android:layout_margin="8dp"
                android:background="@drawable/bote_canicas"
                android:columnCount="4"/>
        </LinearLayout>

        <TextView
            android:id="@+id/textoAyuda"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textColor="@color/white"
            android:fontFamily="@font/syne"
            android:textStyle="bold"
            android:gravity="center"
            android:layout_marginTop="20dp"
            android:text="¡Puedes arrastrar las canicas a los espacios en blanco para ayudarte a contar! Manten pulsado y arrástralas hacia los botes."
            android:textSize="16sp"
            app:layout_constraintBottom_toTopOf="@id/paleta_container1"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/btn_respuesta" />

        <androidx.appcompat.widget.AppCompatButton
            android:id="@+id/btn_respuesta"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Comprobar resultado"
            android:textStyle="bold"
            android:background="@drawable/btn_pixel_style"
            android:fontFamily="@font/syne"
            android:textColor="#FFFFFF"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toBottomOf="@id/botes_container"
            app:layout_constraintBottom_toTopOf="@id/textoAyuda"/>

        <LinearLayout
            android:id="@+id/paleta_container1"
            android:layout_width="300dp"
            android:layout_height="80dp"
            android:orientation="horizontal"
            android:gravity="center"
            android:padding="10dp"
            android:background="#52000000"
            app:layout_constraintTop_toBottomOf="@id/textoAyuda"
            app:layout_constraintBottom_toTopOf="@id/paleta_container2"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent">

            <ImageView
                android:id="@+id/canica1"
                android:layout_width="60dp"
                android:layout_height="60dp"
                android:tag="canica_colores"
                android:src="@drawable/canica1" />

            <ImageView
                android:id="@+id/canica2"
                android:layout_width="60dp"
                android:layout_height="60dp"
                android:tag="canica_guinda"
                android:src="@drawable/canica2"
                android:layout_marginStart="16dp"/>

            <ImageView
                android:id="@+id/canica3"
                android:layout_width="60dp"
                android:layout_height="60dp"
                android:tag="canica_amarilla"
                android:src="@drawable/canica4"
                android:layout_marginStart="16dp"/>
        </LinearLayout>

        <LinearLayout
            android:id="@+id/paleta_container2"
            android:layout_width="300dp"
            android:layout_height="80dp"
            android:orientation="horizontal"
            android:gravity="center"
            android:padding="10dp"
            android:background="#52000000"
            app:layout_constraintTop_toBottomOf="@id/paleta_container1"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent">

            <ImageView
                android:id="@+id/canica4"
                android:layout_width="60dp"
                android:layout_height="60dp"
                android:tag="canica_trans"
                android:src="@drawable/canica5" />

            <ImageView
                android:id="@+id/canica5"
                android:layout_width="60dp"
                android:layout_height="60dp"
                android:tag="canica_azul"
                android:src="@drawable/canica6"
                android:layout_marginStart="16dp"/>
        </LinearLayout>

    </androidx.constraintlayout.widget.ConstraintLayout>
</FrameLayout>

